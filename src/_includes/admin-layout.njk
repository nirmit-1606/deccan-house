<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Admin — Deccan House" }}</title>
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/images/favicon_io/apple-touch-icon.png' | url }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/images/favicon_io/favicon-32x32.png' | url }}">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ '/images/favicon_io/favicon-16x16.png' | url }}">
  <link rel="manifest" href="{{ '/images/favicon_io/site.webmanifest' | url }}">
  <link rel="shortcut icon" href="{{ '/images/favicon_io/favicon.ico' | url }}">
  <link rel="stylesheet" href="{{ '/css/admin.css' | url }}">
</head>
<body class="admin-body">
  {{ content | safe }}
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
  <script>
    window.siteConfig = {
      supabase: {
        url: "{{ site.supabaseUrl }}",
        anonKey: "{{ site.supabaseAnonKey }}"
      },
      tables: {
        menuItems: "deccan_house_menu_items",
        categories: "deccan_house_categories"
      }
    };
  </script>
  <script type="module" src="{{ '/js/admin.js' | url }}"></script>
</body>
</html>
